# Copy this file to .env and fill in your values.

# Your Google Gemini API key — obtain one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of origins allowed to call /api/*
# For local development this should be http://localhost:3000
# For production set it to your actual domain, e.g. https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:3000

# Express server port (default: 3001)
PORT=3001

# Set to "production" when deploying
NODE_ENV=development
